#include <plugin-support.h>
#include "mfd-build-info.h"

const char *PLUGIN_NAME = "@CMAKE_PROJECT_NAME@";
const char *PLUGIN_VERSION = "@CMAKE_PROJECT_VERSION@";
const char *PLUGIN_GIT_COMMIT = MFD_BUILD_GIT_COMMIT;
const char *PLUGIN_BUILT_AT = MFD_BUILD_TIMESTAMP;

void obs_log(int log_level, const char *format, ...)
{
	size_t length = 4 + strlen(PLUGIN_NAME) + strlen(format);

	char *msg_template = malloc(length + 1);
	if (!msg_template) {
		return;
	}

	snprintf(msg_template, length + 1, "[%s] %s", PLUGIN_NAME, format);

	va_list args;
	va_start(args, format);
	blogva(log_level, msg_template, args);
	va_end(args);

	free(msg_template);
}
